# ============================================================================
# Environment variables
# ============================================================================
# Copy this file to `.env` (or `.env.local`) and fill in the values below.
# Vite exposes every variable prefixed with `VITE_` to the client-side bundle,
# so ONLY put public/publishable values here — never secrets.
# ============================================================================

# ----------------------------------------------------------------------------
# Stripe (required for /checkout and subscriptions)
# ----------------------------------------------------------------------------
# Get these from https://dashboard.stripe.com/test/apikeys (Test mode toggle
# in the top-left). Real publishable keys are ~107 characters long.
#
# Use pk_test_... + price IDs from your test products during development,
# and pk_live_... + price IDs from your live products in production.

VITE_STRIPE_PUBLISHABLE_KEY=pk_live_51T8qmop1fmo-favu-xehg-QioBMXEB

# Price IDs for the two subscription plans. Create the products in the Stripe
# dashboard (Products → Add product → Recurring), then copy the generated
# price_... IDs from each price.
VITE_STRIPE_PRICE_MONTHLY=price_XXXXXXXXXXXXXXXXXXXXXXXX
VITE_STRIPE_PRICE_YEARLY=price_XXXXXXXXXXXXXXXXXXXXXXXX

# Optional: only needed if you are using Stripe Connect and want payments
# processed on a connected account. Leave blank otherwise.
# VITE_STRIPE_ACCOUNT_ID=acct_XXXXXXXXXXXXXXXX

# ----------------------------------------------------------------------------
# SECRETS — DO NOT PUT THESE IN THIS FILE
# ----------------------------------------------------------------------------
# The following are SERVER-SIDE secrets. Configure them as Supabase Edge
# Function secrets (Dashboard → Edge Functions → Secrets), NOT as VITE_*
# variables — anything prefixed with VITE_ gets bundled into the public
# client-side JavaScript.
#
#   STRIPE_SECRET_KEY         sk_test_... or sk_live_...
#   STRIPE_WEBHOOK_SECRET     whsec_... from Stripe Dashboard → Webhooks →
#                             your endpoint → "Signing secret"
#   SUPABASE_URL              https://<project-ref>.supabase.co
#   SUPABASE_SERVICE_ROLE_KEY service-role key (bypasses RLS for webhook writes)
#
# Stripe webhook endpoint URL to register in the Stripe Dashboard:
#   https://<project-ref>.functions.supabase.co/stripe-webhook
# Subscribe to these events:
#   invoice.paid
#   invoice.payment_failed
#   customer.subscription.updated
#   customer.subscription.deleted
